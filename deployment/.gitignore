# Release builders deliberately write immutable artifacts below deployment/.
# Keep generated bundles, image archives, logs, and verification evidence out
# of source control.
dist-*/
test-artifacts/
verification-*/
**/__pycache__/
*.py[cod]
*.log
*.tar
*.tar.gz
*.sha256
*.receipt
mongo-image.env

# Site-specific release inputs and rendered manifests are never source files.
release-config
release-config.*
!release-config.example
.env
.env.*
!*.env.in
remote-test-v7/manifest/release.env
