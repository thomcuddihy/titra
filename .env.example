# Public URL used by Titra. Production deployments should use HTTPS.
ROOT_URL=https://titra.example.com

# Generate once with: openssl rand -base64 16
# Keep the same value across upgrades and matching database restores.
TITRA_OAUTH_SECRET_KEY=

# Exact comma-separated private integration hostnames, when deliberately used.
TITRA_PRIVATE_INTEGRATION_HOSTS=

# Exact lowercase "true" enables a flag. These unsafe or temporary switches
# are disabled in the example.
TITRA_ALLOW_LOOPBACK_HTTP_INTEGRATIONS=false
TITRA_OIDC_ALLOW_INSECURE_LOOPBACK=false
TITRA_OIDC_ALLOW_VERIFIED_EMAIL_LINKING=false
TITRA_ENABLE_UNSAFE_LEGACY_SCRIPTS=false
TITRA_ENABLE_HSTS=false
TITRA_ENABLE_FIRST_USER_ADMIN=false
TITRA_ENABLE_ADMIN_RECOVERY=false

# Leave empty to use the reviewed application default.
TITRA_OPENAI_MODEL=
